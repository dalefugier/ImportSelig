<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RhinoCommonVersion>9.0.26300.9401</RhinoCommonVersion>
    <Version>$(RhinoCommonVersion)</Version>
    <Title>ImportSelig</Title>
    <Description>Import Selig Airfoil Data</Description>
    <TargetExt>.rhp</TargetExt>
    <Copyright>Copyright (c) 2022-2026, Dale Fugier</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="EmbeddedResources\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonVersion)" IncludeAssets="compile;build" />
  </ItemGroup>
</Project>
